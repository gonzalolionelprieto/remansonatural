---
/** Drawer del carrito. La UI se rellena en cliente desde lib/cart.ts. */
import { zonas, zonaDefault } from '../lib/shipping';
import { formatPrice } from '../lib/format';
import { getCatalog } from '../lib/catalog';
import { lineaColor } from '../lib/types';

// Catálogo mínimo para el upsell del carrito, embebido como JSON. El drawer
// vive en el layout, así que esto se resuelve una vez por render y sale del
// cache de catalog.ts (no dispara una consulta por página).
const catalogo = await getCatalog();
const sugerencias = catalogo
  .filter((p) => (p.stock ?? 0) > 0)
  .map((p) => ({
    slug: p.slug,
    nombre: p.nombre,
    precio: p.precio,
    linea: p.linea,
    tipo: p.tipo,
    stock: p.stock ?? 0,
    sub: [p.volumen, p.descripcionCorta].filter(Boolean).join(' · '),
    img: p.imagenes?.[0] ?? '',
    color: lineaColor[p.linea],
    // El carrito necesita saber qué producto admite suscripción para poder
    // ofrecerla sobre una línea que ya está adentro.
    suscribible: p.suscribible === true,
  }));
---

<div class="cart" data-cart>
  <div class="cart-backdrop" data-cart-close aria-hidden="true"></div>

  <aside
    class="cart-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Tu carrito"
    data-cart-panel
  >
    <header class="cart-head">
      <h2>Tu carrito</h2>
      <button class="cart-x" type="button" data-cart-close aria-label="Cerrar carrito">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </header>

    <!-- Barra de envío gratis (persuasión) -->
    <div class="ship" data-ship hidden>
      <p class="ship-msg" data-ship-msg></p>
      <div class="ship-bar"><span data-ship-fill></span></div>
    </div>

    <div class="cart-body">
      <!-- Paso 1: Lista de items -->
      <div data-step-view="1">
        <!-- Aviso de stock: aparece si algo se agotó mientras compraba -->
        <div class="stock-alert" data-stock-alert role="status" aria-live="polite" hidden></div>

        <ul class="cart-items" data-cart-list role="list"></ul>

        <!--
          Upsell. UN solo momento, y acá: el carrito es donde la persona ya
          decidió comprar, así que sumar algo cuesta poco. Las marcas del
          rubro interrumpen con un modal al agregar, otro después, y otro en
          el checkout. Eso convierte, pero a costa de que la compra se sienta
          una pelea. Una fila que no tapa nada y que se puede ignorar hace
          casi lo mismo sin ese precio.
        -->
        <!--
          Doble upsell: la segunda pregunta, y la última.
          Llega DESPUÉS de que ya eligió todo, que es cuando una decisión más
          suma en vez de frenar. Al agregar un producto la decisión tiene que
          ser de un click; acá, con el carrito armado, se puede pedir algo
          más grande. Nunca se convierte solo: un débito automático que la
          persona no eligió expresamente termina en contracargo.
        -->
        <div class="sub-offer" data-sub-offer hidden></div>

        <div class="upsell" data-upsell hidden>
          <p class="upsell-t" data-upsell-t>Sumá a tu ritual</p>
          <ul class="upsell-list" data-upsell-list role="list"></ul>
        </div>
        <script
          type="application/json"
          data-upsell-data
          is:inline
          set:html={JSON.stringify(sugerencias)}
        />

        <div class="cart-empty" data-cart-empty>
          <p class="empty-t">Tu carrito está vacío</p>
          <p class="empty-s">Explorá la colección y armá tu ritual.</p>
          <a class="btn btn-ghost" href="/tienda" data-cart-close>Ver la tienda</a>
        </div>
      </div>

      <!-- Paso 2: Formulario de datos de envío y contacto -->
      <div data-step-view="2" class="co-form" hidden>
        <h3 class="co-section-title">Datos de contacto</h3>
        <div class="co-field">
          <label for="co-email">Email</label>
          <input type="email" id="co-email" placeholder="ejemplo@correo.com" required />
        </div>
        <div class="co-field">
          <label for="co-nombre">Nombre y Apellido</label>
          <input type="text" id="co-nombre" placeholder="Juan Pérez" required />
        </div>
        <div class="co-field">
          <label for="co-tel">WhatsApp</label>
          <input type="tel" id="co-tel" placeholder="11 1234 5678" required />
        </div>

        <h3 class="co-section-title" style="margin-top:1.5rem;">Entrega</h3>
        <!-- El CP va primero y filtra las formas de entrega a las que
             realmente llegan ahí. Antes se elegía de una lista completa y
             equivocarse costaba plata: si elegía la barata que no cubre su
             zona, había que pedirle la diferencia después. -->
        <div class="co-field">
          <label for="co-cp">Código postal</label>
          <input type="text" id="co-cp" inputmode="numeric" maxlength="4" placeholder="1832" autocomplete="postal-code" required />
          <p class="co-hint" data-cp-zona hidden></p>
        </div>
        <div class="co-field">
          <label for="co-envio">Forma de entrega</label>
          <select id="co-envio">
            {zonas().map((z) => (
              <option value={z.id} selected={z.id === zonaDefault()}>
                {z.costo === 0 ? `${z.label} — Gratis` : `${z.label} — ${formatPrice(z.costo)}`}
              </option>
            ))}
          </select>
        </div>
        <div class="co-field">
          <label for="co-direccion">Dirección</label>
          <input type="text" id="co-direccion" placeholder="Calle y número" required />
        </div>
        <div class="co-field">
          <label for="co-localidad">Localidad</label>
          <input type="text" id="co-localidad" placeholder="Ej. Lomas de Zamora" required />
        </div>
      </div>
    </div>

    <footer class="cart-foot" data-cart-foot hidden>
      <!-- Footer Paso 1 -->
      <div data-footer-step="1">
        <div class="cart-subtotal">
          <span>Subtotal</span>
          <b data-cart-total>$0</b>
        </div>
        <!-- Con un carrito mixto, la pregunta que queda es "¿qué me van a
             volver a cobrar?". Se responde acá, con números, antes de pagar. -->
        <div class="cart-desglose" data-cart-desglose hidden></div>
        <p class="cart-ahorro" data-cart-ahorro hidden></p>
        <p class="cart-note">El costo de envío se calculará en el siguiente paso.</p>
        <button class="btn btn-solid cart-checkout" type="button" data-next-step>
          Siguiente paso
        </button>
        <a class="cart-keep" href="/tienda" data-cart-close>Seguir comprando</a>
      </div>

      <!-- Footer Paso 2 -->
      <div data-footer-step="2" hidden>
        <div class="cart-subtotal" style="font-size:0.9rem; color:var(--text-soft);">
          <span>Productos</span>
          <span data-checkout-subtotal>$0</span>
        </div>
        <div class="cart-subtotal" style="font-size:0.9rem; color:var(--text-soft); margin-top:0.35rem;">
          <span>Costo de envío</span>
          <span data-checkout-shipping>$0</span>
        </div>
        <div class="cart-subtotal" style="margin-top:0.6rem; border-top:1px solid var(--border); padding-top:0.6rem;">
          <span>Total</span>
          <b data-checkout-total>$0</b>
        </div>
        <div style="display:flex; gap:0.5rem; margin-top:0.9rem;">
          <button class="btn ghost" type="button" data-prev-step style="flex:1; font-size:0.9rem; padding-inline:0.5rem;">
            Volver
          </button>
          <button class="btn btn-solid" type="button" data-checkout style="flex:2; font-size:0.9rem;">
            Pagar
          </button>
        </div>
        <p class="cart-msg" data-checkout-msg role="status" aria-live="polite"></p>
      </div>
    </footer>
  </aside>
</div>

<style>
  .cart {
    position: fixed;
    inset: 0;
    z-index: var(--z-drawer);
    pointer-events: none;
    visibility: hidden;
  }
  .cart[data-open] {
    pointer-events: auto;
    visibility: visible;
  }
  .cart-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(30, 30, 30, 0.42);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }
  .cart[data-open] .cart-backdrop {
    opacity: 1;
  }
  .cart-panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(92vw, 400px);
    background: var(--crema);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-lg);
    transform: translateX(100%);
    transition: transform var(--dur) var(--ease-out);
  }
  .cart[data-open] .cart-panel {
    transform: translateX(0);
  }

  .cart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.35rem;
    border-bottom: 1px solid var(--border);
  }
  .cart-head h2 {
    font-size: 1.3rem;
  }
  .cart-x {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: none;
    background: none;
    color: var(--verde);
    cursor: pointer;
    border-radius: var(--r-full);
  }
  .cart-x:hover {
    background: rgba(47, 74, 58, 0.08);
  }
  .cart-x svg {
    width: 22px;
    height: 22px;
  }

  .ship {
    padding: 0.9rem 1.35rem;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
  }
  .ship-msg {
    font-size: 0.82rem;
    color: var(--text-soft);
    margin-bottom: 0.5rem;
  }
  .ship-msg b {
    color: var(--verde);
  }
  .ship-bar {
    height: 6px;
    border-radius: var(--r-full);
    background: var(--crema-2);
    overflow: hidden;
  }
  .ship-bar span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--salvia), var(--verde));
    transition: width var(--dur-slow) var(--ease-out);
  }

  .cart-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem 1.35rem;
  }
  
  /* Formulario Checkout */
  .co-section-title {
    font-size: 1.05rem;
    font-family: var(--font-serif);
    color: var(--verde);
    margin-block: 0.85rem 0.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.25rem;
  }
  .co-field {
    margin-bottom: 0.75rem;
  }
  .co-field label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-soft);
    margin-bottom: 0.25rem;
  }
  .co-field input, .co-field select {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--border-strong);
    background: var(--crema);
    border-radius: var(--r-btn);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--text);
  }
  .co-field input:focus, .co-field select:focus {
    outline: none;
    border-color: var(--verde);
    box-shadow: 0 0 0 2px rgba(47, 74, 58, 0.1);
  }

  .cart-items {
    display: grid;
    gap: 0.25rem;
  }
  /* Los items del carrito se inyectan por JS (innerHTML), así que no reciben
     el atributo de scope de Astro: sus estilos deben ser :global. */
  .cart-body :global(.cart-item) {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 0.85rem;
    align-items: start;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .cart-body :global(.ci-thumb) {
    width: 56px;
    height: 56px;
    border-radius: var(--r-sm);
    background: var(--crema-2);
    display: grid;
    place-items: center;
    position: relative;
  }
  .cart-body :global(.ci-thumb .dot) {
    width: 12px;
    height: 12px;
    border-radius: var(--r-full);
  }
  .cart-body :global(.ci-name) {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--verde);
    line-height: 1.2;
  }
  .cart-body :global(.ci-price) {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }
  .cart-body :global(.ci-price s) {
    opacity: 0.65;
    margin-right: 0.2rem;
  }
  /* Etiquetas de modalidad: el cliente tiene que ver a simple vista qué
     línea se le va a repetir y cuál no. */
  .cart-body :global(.ci-sub),
  .cart-body :global(.ci-once) {
    display: inline-block;
    margin-top: 0.3rem;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: var(--r-pill);
    padding: 0.2rem 0.55rem;
  }
  .cart-body :global(.ci-sub) {
    color: var(--verde);
    background: color-mix(in srgb, var(--salvia) 20%, transparent);
  }
  /* La de compra única es deliberadamente más apagada: informa sin competir
     con la suscripción, que es lo que queremos que se elija. */
  .cart-body :global(.ci-once) {
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border);
  }

  .cart-desglose {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--border);
    font-size: 0.82rem;
    color: var(--text-soft);
  }
  .cart-desglose :global(p) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .cart-desglose :global(b) {
    color: var(--verde);
    font-weight: 600;
  }

  .upsell-t :global(em) {
    font-style: normal;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  /* ---- Doble upsell: pasar a suscripción ----
     Verde de marca y no el naranja de una promo: la suscripción se vende
     como pertenecer a algo, no como una liquidación. */
  .sub-offer {
    margin-top: 1.2rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--verde);
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--salvia) 12%, transparent);
  }
  .sub-offer :global(.so-eyebrow) {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--verde);
    margin-bottom: 0.4rem;
  }
  .sub-offer :global(.so-t) {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--verde);
    line-height: 1.3;
  }
  .sub-offer :global(.so-t b) {
    font-weight: 600;
  }
  .sub-offer :global(.so-s) {
    font-size: 0.8rem;
    color: var(--text-soft);
    margin-top: 0.35rem;
    line-height: 1.5;
  }
  .sub-offer :global(.so-s b) {
    color: var(--verde);
    font-weight: 600;
  }
  .sub-offer :global(.so-btn) {
    width: 100%;
    margin-top: 0.8rem;
    border: none;
    border-radius: var(--r-btn);
    background: var(--verde);
    color: var(--crema);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    padding: 0.7rem 1rem;
    cursor: pointer;
    transition: background var(--dur) var(--ease-out);
  }
  .sub-offer :global(.so-btn:hover) {
    background: var(--verde-900);
  }

  /* ---- Upsell del carrito ----
     Los .us-* se inyectan por innerHTML, así que Astro no les pone el
     atributo de scope: van con :global desde el contenedor. */
  .upsell {
    margin-top: 1.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border);
  }
  .upsell-t {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--verde);
    margin-bottom: 0.7rem;
  }
  .upsell-list {
    display: grid;
    gap: 0.5rem;
    list-style: none;
  }
  .cart-body :global(.us-item) {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: center;
    gap: 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 0.5rem 0.6rem;
  }
  .cart-body :global(.us-thumb) {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-sm);
    overflow: hidden;
    background: var(--crema-3);
  }
  .cart-body :global(.us-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cart-body :global(.us-dot) {
    width: 12px;
    height: 12px;
    border-radius: var(--r-full);
  }
  .cart-body :global(.us-name) {
    font-size: 0.87rem;
    color: var(--verde);
    line-height: 1.25;
  }
  .cart-body :global(.us-name:hover) {
    color: var(--tierra);
  }
  .cart-body :global(.us-sub) {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-top: 0.05rem;
  }
  .cart-body :global(.us-price) {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--verde);
    margin-top: 0.15rem;
  }
  .cart-body :global(.us-add) {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--verde);
    border-radius: var(--r-btn);
    background: transparent;
    color: var(--verde);
    cursor: pointer;
    transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }
  .cart-body :global(.us-add svg) {
    width: 16px;
    height: 16px;
  }
  .cart-body :global(.us-add:hover),
  .cart-body :global(.us-add.is-added) {
    background: var(--verde);
    color: var(--crema);
  }

  .co-hint {
    font-size: 0.78rem;
    color: var(--salvia);
    margin-top: 0.3rem;
  }

  .cart-ahorro {
    font-size: 0.82rem;
    color: var(--salvia);
    margin-top: 0.35rem;
  }
  .cart-ahorro b {
    color: var(--verde);
    font-weight: 600;
  }
  .cart-body :global(.ci-controls) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.7rem;
  }
  .cart-body :global(.ci-qty) {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-btn);
    overflow: hidden;
  }
  .cart-body :global(.ci-qty button) {
    width: 30px;
    height: 30px;
    border: none;
    background: none;
    color: var(--verde);
    cursor: pointer;
    font-size: 1.05rem;
    line-height: 1;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .cart-body :global(.ci-qty button:hover) {
    background: rgba(47, 74, 58, 0.08);
  }
  .cart-body :global(.ci-qty button:disabled) {
    color: var(--text-muted);
    cursor: not-allowed;
  }
  .cart-body :global(.ci-qty button:disabled:hover) {
    background: none;
  }
  .cart-body :global(.ci-qty span) {
    min-width: 26px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .cart-body :global(.ci-remove) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: none;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .cart-body :global(.ci-remove svg) {
    width: 14px;
    height: 14px;
  }
  .cart-body :global(.ci-remove:hover) {
    color: var(--tierra);
  }
  .cart-body :global(.ci-line) {
    text-align: right;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--verde);
    align-self: start;
    padding-top: 0.1rem;
    white-space: nowrap;
  }

  /* Aviso de stock dentro del carrito */
  .stock-alert {
    margin: 0.9rem 0 0.25rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--tierra);
    border-left-width: 3px;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--tierra) 7%, transparent);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text);
  }
  .stock-alert[hidden] {
    display: none;
  }
  .stock-alert b {
    color: var(--tierra);
  }

  .cart-empty {
    text-align: center;
    padding: 3rem 1rem;
  }
  .empty-t {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--verde);
    margin-bottom: 0.35rem;
  }
  .empty-s {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
  }

  .cart-foot {
    padding: 1.25rem 1.35rem calc(1.25rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--border);
    background: var(--crema);
  }
  .cart-subtotal {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 0.95rem;
  }
  .cart-subtotal b {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--verde);
  }
  .cart-note {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0.35rem 0 0.9rem;
  }
  .cart-checkout {
    width: 100%;
  }
  .cart-msg {
    min-height: 1.1em;
    font-size: 0.8rem;
    color: var(--tierra);
    text-align: center;
    margin-top: 0.6rem;
  }
  .cart-keep {
    display: block;
    text-align: center;
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cart-keep:hover {
    color: var(--tierra);
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-backdrop,
    .cart-panel,
    .ship-bar span {
      transition: none;
    }
  }
</style>

<script>
  import * as cart from '../lib/cart';
  import { FRECUENCIA_LABEL } from '../lib/pricing';
  import {
    costoEnvio,
    tieneEnvioGratis,
    envioGratisDesde,
    zonaGratisLabel,
    zonaDefault,
    zonaPorCP,
    opcionesPara,
    ZONA_CP_LABEL,
  } from '../lib/shipping';

  const fmt = (n: number) => `$${n.toLocaleString('es-AR')}`;
  // Mismo criterio que la ficha de producto: si no tenemos stock conocido,
  // no capeamos (99 es el tope general del carrito).
  const maxQty = (stock: number) => (stock > 0 ? Math.min(99, stock) : 99);
  const lineColors: Record<string, string> = {
    alquimia: '#2F4A3A',
    bach: '#9A86A6',
    humos: '#A87C5A',
    cristales: '#789B8C',
  };

  let globalBound = false;
  let currentStep = 1;

  function openCart() {
    document.querySelector('[data-cart]')?.setAttribute('data-open', '');
    document.body.style.overflow = 'hidden';
    const alerta = document.querySelector<HTMLElement>('[data-stock-alert]');
    if (alerta) alerta.hidden = true;
    setStep(1);
  }
  function closeCart() {
    document.querySelector('[data-cart]')?.removeAttribute('data-open');
    document.body.style.overflow = '';
  }

  // El costo sale de lib/shipping (el mismo que aplica el checkout).
  const getShippingCost = costoEnvio;

  function setStep(step: number) {
    currentStep = step;
    
    // Cambiar vistas
    document.querySelector<HTMLElement>('[data-step-view="1"]')!.hidden = step !== 1;
    document.querySelector<HTMLElement>('[data-step-view="2"]')!.hidden = step !== 2;
    
    // Cambiar footers
    document.querySelector<HTMLElement>('[data-footer-step="1"]')!.hidden = step !== 1;
    document.querySelector<HTMLElement>('[data-footer-step="2"]')!.hidden = step !== 2;

    // Si pasamos al paso 2, ocultar temporalmente la barra de envío gratis para no saturar la UI
    const ship = document.querySelector<HTMLElement>('[data-ship]');
    if (ship) ship.hidden = step === 2 || cart.count() === 0;

    if (step === 2) {
      updateCheckoutSummary();
    }
  }

  function updateCheckoutSummary() {
    const subtotal = cart.total();
    const zone = document.querySelector<HTMLSelectElement>('#co-envio')?.value ?? zonaDefault();
    const shipping = getShippingCost(cart.contextoEnvio(), zone);
    const total = subtotal + shipping;

    const subtotalEl = document.querySelector('[data-checkout-subtotal]');
    const shippingEl = document.querySelector('[data-checkout-shipping]');
    const totalEl = document.querySelector('[data-checkout-total]');

    if (subtotalEl) subtotalEl.textContent = fmt(subtotal);
    if (shippingEl) shippingEl.textContent = shipping === 0 ? 'Gratis' : fmt(shipping);
    if (totalEl) totalEl.textContent = fmt(total);
  }

  /**
   * Aviso dentro del carrito. Reusa la caja del aviso de stock: es el mismo
   * rol (contarle algo que pasó con su pedido) y no hace falta un segundo
   * componente que compita por el mismo espacio.
   */
  function avisar(texto: string) {
    const box = document.querySelector<HTMLElement>('[data-stock-alert]');
    if (!box) return;
    box.textContent = texto;
    box.hidden = false;
    window.setTimeout(() => {
      if (box.textContent === texto) box.hidden = true;
    }, 7000);
  }

  /**
   * Explica en el carrito qué producto se quedó sin stock y qué hicimos.
   * El carrito ya viene ajustado; esto sólo cuenta lo que pasó.
   */
  function mostrarAvisoStock(sinStock: Array<{ nombre: string; disponible: number }>) {
    const box = document.querySelector<HTMLElement>('[data-stock-alert]');
    if (!box) return;

    const lineas = sinStock.map((p) =>
      p.disponible > 0
        ? `De <b>${p.nombre}</b> quedan ${p.disponible}. Ajustamos la cantidad.`
        : `<b>${p.nombre}</b> se quedó sin stock y lo sacamos del carrito.`
    );

    box.innerHTML = `${lineas.join('<br>')}<br>Revisá el carrito y volvé a intentar el pago.`;
    box.hidden = false;
    box.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }

  // Checkout: crea la preferencia en el server y redirige a Mercado Pago.
  async function doCheckout(btn: HTMLButtonElement) {
    const items = cart.getItems();
    if (items.length === 0) return;

    // Validación del formulario
    const email = document.querySelector<HTMLInputElement>('#co-email')?.value.trim();
    const nombre = document.querySelector<HTMLInputElement>('#co-nombre')?.value.trim();
    const tel = document.querySelector<HTMLInputElement>('#co-tel')?.value.trim();
    const direccion = document.querySelector<HTMLInputElement>('#co-direccion')?.value.trim();
    const localidad = document.querySelector<HTMLInputElement>('#co-localidad')?.value.trim();
    const cp = document.querySelector<HTMLInputElement>('#co-cp')?.value.trim();
    const metodoEnvio = document.querySelector<HTMLSelectElement>('#co-envio')?.value ?? zonaDefault();

    const msg = document.querySelector<HTMLElement>('[data-checkout-msg]');
    if (msg) msg.textContent = '';

    if (!email || !nombre || !tel || !direccion || !localidad || !cp) {
      if (msg) msg.textContent = 'Por favor, completá todos los campos obligatorios.';
      return;
    }
    // Sin CP válido no podemos saber a qué zona va ni cobrar el envío que
    // corresponde: mejor frenarlo acá que despachar cobrando de menos.
    if (!zonaPorCP(cp)) {
      if (msg) msg.textContent = 'Revisá el código postal: tiene que ser de 4 dígitos.';
      return;
    }

    const original = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Cargando pago…';

    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          // El servidor recalcula precio y descuento con los datos de la base:
          // acá sólo mandamos QUÉ se quiere comprar, nunca cuánto sale.
          items: items.map((i) => ({
            slug: i.slug,
            qty: i.qty,
            modalidad: i.modalidad,
            frecuencia: i.frecuencia,
          })),
          cliente: {
            nombre,
            email,
            whatsapp: tel,
            direccion,
            localidad,
            cp,
            metodoEnvio,
          }
        }),
      });
      const data = await res.json();
      if (res.ok && data.init_point) {
        // NO vaciamos el carrito acá: si el usuario vuelve atrás desde Mercado
        // Pago sin pagar, tiene que encontrar su carrito intacto. El carrito se
        // vacía sólo cuando el pago se confirma, al llegar a /gracias.
        window.location.href = data.init_point;
        return;
      }

      // 409: algo se quedó sin stock entre que lo agregó y tocó Pagar.
      // Ajustamos el carrito solo y le explicamos exactamente qué pasó,
      // en vez de dejarlo con un error genérico que no puede resolver.
      if (res.status === 409 && Array.isArray(data.sinStock)) {
        for (const p of data.sinStock) cart.ajustarPorStock(p.slug, p.disponible);
        setStep(1);
        if (msg) msg.textContent = '';
        mostrarAvisoStock(data.sinStock);
        btn.disabled = false;
        btn.textContent = original;
        return;
      }

      if (msg) msg.textContent = data.error ?? 'No se pudo iniciar el pago.';
    } catch {
      if (msg) msg.textContent = 'Error de conexión. Intentá de nuevo.';
    }
    btn.disabled = false;
    btn.textContent = original;
  }

  function render() {
    const items = cart.getItems();
    const n = cart.count();

    // Badges del header
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((b) => {
      b.textContent = String(n);
      b.hidden = n === 0;
    });

    const list = document.querySelector<HTMLElement>('[data-cart-list]');
    const empty = document.querySelector<HTMLElement>('[data-cart-empty]');
    const foot = document.querySelector<HTMLElement>('[data-cart-foot]');
    if (!list) return;

    if (empty) empty.hidden = n > 0;
    if (foot) foot.hidden = n === 0;

    // Si el carrito mezcla modalidades hay que etiquetar TODAS las líneas.
    // Marcando sólo la suscripción, las de al lado se leen como si también
    // se repitieran todos los meses.
    const mixto = cart.esMixto();

    list.innerHTML = items
      .map((i) => {
        const atMax = i.qty >= maxQty(i.stock);
        const key = cart.keyOf(i);
        const unit = cart.unitPrice(i);
        const conDescuento = unit < i.precio;
        return `
      <li class="cart-item" data-key="${key}">
        <span class="ci-thumb"><span class="dot" style="background:${lineColors[i.linea] ?? 'var(--salvia)'}"></span></span>
        <div>
          <p class="ci-name">${i.nombre}</p>
          ${i.modalidad === 'suscripcion'
            ? `<p class="ci-sub">Se repite · ${(FRECUENCIA_LABEL[i.frecuencia ?? 30] ?? 'Cada 30 días').toLowerCase()}</p>`
            : mixto
              ? `<p class="ci-once">Solo esta vez</p>`
              : ''}
          <p class="ci-price">${conDescuento ? `<s>${fmt(i.precio)}</s> ` : ''}${fmt(unit)} c/u</p>
          <div class="ci-controls">
            <span class="ci-qty">
              <button type="button" data-cart-dec data-key="${key}" aria-label="Quitar uno">−</button>
              <span>${i.qty}</span>
              <button type="button" data-cart-inc data-key="${key}" aria-label="Agregar uno"${atMax ? ' disabled' : ''}>+</button>
            </span>
            <button class="ci-remove" type="button" data-cart-remove data-key="${key}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>Quitar</button>
          </div>
        </div>
        <span class="ci-line">${fmt(cart.lineTotal(i))}</span>
      </li>`;
      })
      .join('');

    const totalEl = document.querySelector<HTMLElement>('[data-cart-total]');
    if (totalEl) totalEl.textContent = fmt(cart.total());

    // Desglose: qué se repite y qué se cobra una sola vez. Sin esto, alguien
    // que sumó un kit desde las sugerencias no tiene forma de saber si se lo
    // vamos a mandar todos los meses.
    const desgloseEl = document.querySelector<HTMLElement>('[data-cart-desglose]');
    if (desgloseEl) {
      const sus = cart.totalSuscripcion();
      desgloseEl.hidden = sus === 0;
      if (sus > 0) {
        const frecs = cart.frecuenciasEnCarrito();
        const cadaCuanto =
          frecs.length === 1
            ? (FRECUENCIA_LABEL[frecs[0] as 30 | 45 | 60] ?? 'Cada 30 días').toLowerCase()
            : 'según la frecuencia de cada uno';
        const unica = cart.totalUnica();
        desgloseEl.innerHTML =
          `<p><span>Se repite ${cadaCuanto}</span><b>${fmt(sus)}</b></p>` +
          (unica > 0
            ? `<p><span>Solo esta vez</span><b>${fmt(unica)}</b></p>`
            : '');
      }
    }

    // Cuánto se está ahorrando: verlo en el carrito sostiene la decisión que
    // ya tomó en la ficha justo antes de pagar.
    const ahorroEl = document.querySelector<HTMLElement>('[data-cart-ahorro]');
    if (ahorroEl) {
      const a = cart.ahorro();
      ahorroEl.hidden = a <= 0;
      ahorroEl.innerHTML = `Estás ahorrando <b>${fmt(a)}</b>`;
    }

    // Barra de envío gratis
    const ship = document.querySelector<HTMLElement>('[data-ship]');
    const shipMsg = document.querySelector<HTMLElement>('[data-ship-msg]');
    const shipFill = document.querySelector<HTMLElement>('[data-ship-fill]');
    if (ship && shipMsg && shipFill) {
      ship.hidden = n === 0 || currentStep === 2;
      // El envío depende del monto del pedido, no de la modalidad: con
      // suscripción o sin ella se cobra igual hasta el mínimo.
      const ctx = cart.contextoEnvio();
      if (tieneEnvioGratis(ctx)) {
        shipMsg.innerHTML = `🌿 <b>¡Tenés envío gratis a ${zonaGratisLabel()}!</b>`;
        shipFill.style.width = '100%';
      } else {
        const falta = envioGratisDesde() - ctx.subtotal;
        shipMsg.innerHTML = `Sumá <b>${fmt(falta)}</b> y el envío a ${zonaGratisLabel()} es gratis`;
        shipFill.style.width = `${Math.min(100, (ctx.subtotal / envioGratisDesde()) * 100)}%`;
      }
    }

    renderSubOffer();
    renderUpsell();

    if (currentStep === 2) {
      updateCheckoutSummary();
    }
  }

  interface Sugerencia {
    slug: string;
    nombre: string;
    precio: number;
    linea: string;
    tipo: string;
    stock: number;
    sub: string;
    img: string;
    color: string;
    suscribible: boolean;
  }

  /**
   * La segunda pregunta del carrito: pasar una línea a suscripción.
   *
   * Sólo aparece si (a) no hay ninguna suscripción todavía y (b) algún
   * producto del carrito la admite. Habla del beneficio en pesos, no en
   * porcentaje: "ahorrás $3.900 y no pagás envío" mueve, "15% off" no.
   */
  function renderSubOffer() {
    const box = document.querySelector<HTMLElement>('[data-sub-offer]');
    if (!box) return;

    const items = cart.getItems();
    if (items.length === 0 || cart.tieneSuscripcion()) {
      box.hidden = true;
      return;
    }

    const catalogo = leerSugerencias();
    const elegible = items.find(
      (i) => catalogo.find((s) => s.slug === i.slug)?.suscribible
    );
    if (!elegible) {
      box.hidden = true;
      return;
    }

    const key = cart.keyOf(elegible);
    const ahorro = cart.ahorroSiSuscribe(key);

    box.hidden = false;
    box.innerHTML = `
      <p class="so-eyebrow">Plan de socio</p>
      <p class="so-t">¿Y si <b>${elegible.nombre}</b> te llega solo todos los meses?</p>
      <p class="so-s">Ahorrás <b>${fmt(ahorro)}</b> en cada envío y no pagás el envío. Cancelás cuando quieras.</p>
      <button class="so-btn" type="button" data-sub-convert="${key}">
        Sí, pasarlo a suscripción
      </button>`;
  }

  let sugerencias: Sugerencia[] | null = null;

  function leerSugerencias(): Sugerencia[] {
    if (sugerencias) return sugerencias;
    const el = document.querySelector('[data-upsell-data]');
    try {
      sugerencias = el ? (JSON.parse(el.textContent ?? '[]') as Sugerencia[]) : [];
    } catch {
      sugerencias = [];
    }
    return sugerencias;
  }

  /**
   * Sugerencias del carrito: hasta tres productos que todavía no llevó.
   *
   * Los kits van primero — un combo de productos distintos es la venta que
   * más conviene y la que más sentido tiene ofrecer a alguien que ya eligió
   * un extracto. Después, lo que ese producto declara que combina bien.
   */
  function renderUpsell() {
    const box = document.querySelector<HTMLElement>('[data-upsell]');
    const list = document.querySelector<HTMLElement>('[data-upsell-list]');
    const titulo = document.querySelector<HTMLElement>('[data-upsell-t]');
    if (!box || !list) return;

    const items = cart.getItems();
    if (items.length === 0) {
      box.hidden = true;
      return;
    }

    const enCarrito = new Set(items.map((i) => i.slug));
    const candidatos = leerSugerencias()
      .filter((s) => !enCarrito.has(s.slug))
      .sort((a, b) => Number(b.tipo === 'kit') - Number(a.tipo === 'kit'))
      .slice(0, 3);

    if (candidatos.length === 0) {
      box.hidden = true;
      return;
    }

    // Si lo que sugerimos primero es un kit, lo decimos: "completá tu ritual"
    // explica mejor por qué le estamos mostrando eso.
    // Si ya hay una suscripción en el carrito, aclaramos que lo que se suma
    // desde acá NO entra en ella: es un agregado de una sola vez.
    if (titulo) {
      const base =
        candidatos[0].tipo === 'kit' ? 'Completá tu ritual' : 'Sumá a tu ritual';
      titulo.innerHTML = cart.tieneSuscripcion()
        ? `${base} <em>· se cobra una sola vez</em>`
        : base;
    }

    box.hidden = false;
    list.innerHTML = candidatos
      .map(
        (s) => `
      <li class="us-item">
        <a class="us-thumb" href="/producto/${s.slug}" tabindex="-1" aria-hidden="true">
          ${s.img
            ? `<img src="${s.img}" alt="" width="96" height="96" loading="lazy">`
            : `<span class="us-dot" style="background:${s.color}"></span>`}
        </a>
        <div class="us-info">
          <a class="us-name" href="/producto/${s.slug}">${s.nombre}</a>
          ${s.sub ? `<p class="us-sub">${s.sub}</p>` : ''}
          <p class="us-price">${fmt(s.precio)}</p>
        </div>
        <button class="us-add" type="button" data-add-to-cart
          data-slug="${s.slug}" data-nombre="${s.nombre}" data-precio="${s.precio}"
          data-linea="${s.linea}" data-stock="${s.stock}"
          aria-label="Agregar ${s.nombre} al carrito">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
        </button>
      </li>`
      )
      .join('');
  }

  function initCart() {
    render();
    if (globalBound) return;
    globalBound = true;

    cart.subscribe(render);

    // Delegación global: sobrevive a las navegaciones con ClientRouter.
    document.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;

      const addBtn = el.closest<HTMLElement>('[data-add-to-cart]');
      if (addBtn) {
        e.preventDefault();
        // La caja de compra de la ficha publica la elección del cliente en
        // sus propios data-*; las cards del catálogo no tienen ninguno y
        // caen al default: una unidad, compra única.
        const scope = addBtn.closest<HTMLElement>(
          '.buybox, .buy, .info, [data-product], article'
        );
        const qtyInput = scope?.querySelector<HTMLInputElement>('[data-qty]');
        const qty =
          Number(addBtn.dataset.qty) ||
          (qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1);
        const modalidad =
          addBtn.dataset.modalidad === 'suscripcion' ? 'suscripcion' : 'unica';
        const resultado = cart.add(
          {
            slug: addBtn.dataset.slug!,
            nombre: addBtn.dataset.nombre!,
            precio: Number(addBtn.dataset.precio),
            linea: addBtn.dataset.linea ?? '',
            stock: Number(addBtn.dataset.stock) || 0,
            modalidad,
            ...(modalidad === 'suscripcion'
              ? { frecuencia: (Number(addBtn.dataset.frecuencia) || 30) as 30 | 45 | 60 }
              : {}),
          },
          qty
        );

        // Feedback "✓ Agregado" en el botón + abrir el drawer
        addBtn.classList.add('is-added');
        window.setTimeout(() => addBtn.classList.remove('is-added'), 1300);
        openCart();

        // El aviso va DESPUÉS de abrir: openCart() limpia la caja de avisos
        // para que no quede uno viejo de la sesión anterior.
        if (resultado === 'suscripcion-ocupada') {
          avisar(
            'Podés tener una sola suscripción por pedido. Lo agregamos como compra única — si preferís suscribirte a este, quitá primero la otra suscripción.'
          );
        }
        return;
      }

      // Doble upsell: pasar una línea a suscripción desde el carrito.
      const convBtn = el.closest<HTMLElement>('[data-sub-convert]');
      if (convBtn) {
        e.preventDefault();
        cart.convertirASuscripcion(convBtn.dataset.subConvert!);
        return;
      }

      if (el.closest('[data-cart-open]')) {
        e.preventDefault();
        openCart();
        return;
      }
      if (el.closest('[data-cart-close]')) {
        closeCart();
        return;
      }
      const inc = el.closest<HTMLElement>('[data-cart-inc]');
      if (inc) {
        const it = cart.getItems().find((i) => cart.keyOf(i) === inc.dataset.key);
        if (it && it.qty < maxQty(it.stock)) cart.setQty(inc.dataset.key!, it.qty + 1);
        return;
      }
      const dec = el.closest<HTMLElement>('[data-cart-dec]');
      if (dec) {
        const it = cart.getItems().find((i) => cart.keyOf(i) === dec.dataset.key);
        if (it) cart.setQty(dec.dataset.key!, it.qty - 1);
        return;
      }
      const rem = el.closest<HTMLElement>('[data-cart-remove]');
      if (rem) {
        cart.remove(rem.dataset.key!);
        return;
      }
      const nextBtn = el.closest<HTMLButtonElement>('[data-next-step]');
      if (nextBtn) {
        setStep(2);
        return;
      }
      const prevBtn = el.closest<HTMLButtonElement>('[data-prev-step]');
      if (prevBtn) {
        setStep(1);
        return;
      }
      const checkoutBtn = el.closest<HTMLButtonElement>('[data-checkout]');
      if (checkoutBtn) {
        void doCheckout(checkoutBtn);
        return;
      }
    });

    // Escuchar cambios de zona de envío para actualizar resumen
    document.addEventListener('change', (e) => {
      const el = e.target as HTMLElement;
      if (el.id === 'co-envio') {
        updateCheckoutSummary();
      }
    });

    // El CP filtra las formas de entrega disponibles y preselecciona la más
    // barata que llegue a esa zona.
    document.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.id !== 'co-cp') return;
      const aviso = document.querySelector<HTMLElement>('[data-cp-zona]');
      const sel = document.querySelector<HTMLSelectElement>('#co-envio');
      if (!sel) return;

      const zona = el.value.replace(/\D/g, '').length === 4 ? zonaPorCP(el.value) : null;
      if (!zona) {
        if (aviso) aviso.hidden = true;
        return;
      }

      const disponibles = opcionesPara(zona);
      if (aviso) {
        aviso.hidden = false;
        aviso.textContent =
          disponibles.length > 0
            ? `Envíos a ${ZONA_CP_LABEL[zona]}`
            : `Todavía no llegamos a ${ZONA_CP_LABEL[zona]}. Escribinos por WhatsApp.`;
      }
      if (disponibles.length === 0) return;

      sel.innerHTML = disponibles
        .map(
          (o) =>
            `<option value="${o.id}">${o.label} — ${
              o.costo === 0 ? 'Gratis' : fmt(o.costo)
            }</option>`
        )
        .join('');
      sel.value = disponibles[0].id;
      updateCheckoutSummary();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeCart();
    });

    // Al volver atrás desde Mercado Pago la página puede restaurarse desde el
    // bfcache con el botón "Pagar" trabado en "Cargando pago…". Lo reseteamos.
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      const checkoutBtn = document.querySelector<HTMLButtonElement>('[data-checkout]');
      if (checkoutBtn) {
        checkoutBtn.disabled = false;
        checkoutBtn.textContent = 'Pagar';
      }
      render();
    });
  }

  document.addEventListener('astro:page-load', initCart);
</script>
