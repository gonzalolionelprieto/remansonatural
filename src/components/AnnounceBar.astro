---
/**
 * Barra superior de anuncios. Los mensajes rotan suavemente (fade) y
 * respetan reduced-motion (se quedan quietos, mostrando el primero).
 */
import { suscripcionOff, transferenciaOff, porcentajeOff } from '../lib/pricing';
import { envioGratisDesde, zonaGratisLabel } from '../lib/shipping';
import { formatPrice } from '../lib/format';

// Los números salen de pricing.ts y shipping.ts: si mañana cambia un
// descuento, la barra no puede quedar prometiendo el viejo.
const messages = [
  'Envíos a todo el país · 3 cuotas sin interés',
  `Envío gratis a ${zonaGratisLabel()} desde ${formatPrice(envioGratisDesde())}`,
  `Suscribite y ahorrá ${porcentajeOff(suscripcionOff())}% en cada envío`,
  `${porcentajeOff(transferenciaOff())}% off pagando por transferencia`,
];
---

<div class="announce" role="region" aria-label="Anuncios de la tienda">
  <div class="announce-track" aria-live="off">
    {messages.map((m, i) => (
      <span class="announce-msg" style={`--i:${i}`}>{m}</span>
    ))}
  </div>
</div>

<!-- `count` sale de la cantidad real de mensajes. Estaba fijo en 3 y había 4:
     el ciclo duraba 12s para 16s de contenido, así que el último mensaje se
     superponía con el primero. Si se agrega o saca uno, se ajusta solo. -->
<style define:vars={{ count: messages.length }}>
  .announce {
    background: var(--verde);
    color: var(--on-dark);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    height: 38px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .announce-track {
    position: relative;
    width: 100%;
    height: 1.2em;
  }

  .announce-msg {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding-inline: 1rem;
    opacity: 0;
    animation: announce-rotate calc(var(--count) * 4s) infinite;
    animation-delay: calc(var(--i) * 4s);
  }

  /* La ventana visible entra holgada dentro de un turno (100/count %): con
     4 mensajes el turno es 25% y acá se apaga en 24%, así nunca se solapan
     dos textos. */
  @keyframes announce-rotate {
    0%,
    2% {
      opacity: 0;
      transform: translateY(60%);
    }
    6%,
    19% {
      opacity: 1;
      transform: translateY(0);
    }
    23%,
    100% {
      opacity: 0;
      transform: translateY(-60%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announce-msg {
      animation: none;
    }
    .announce-msg:first-child {
      opacity: 1;
    }
  }
</style>
