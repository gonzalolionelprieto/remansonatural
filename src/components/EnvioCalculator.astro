---
/**
 * Calculadora de envío.
 *
 * Antes pedía el código postal y estimaba con una tabla propia — que decía
 * números distintos a los que después cobraba el checkout. Ahora ofrece las
 * MISMAS zonas que el checkout y lee los MISMOS precios: lo que se ve acá es
 * exactamente lo que se va a pagar.
 */
import {
  zonas,
  zonaDefault,
  envioGratisUnidades,
  zonaGratisLabel,
} from '../lib/shipping';
---

<div class="envio" data-envio>
  <div class="envio-head">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"></path><circle cx="7" cy="17" r="1.6"></circle><circle cx="17.5" cy="17" r="1.6"></circle></svg>
    <span>Calculá tu envío</span>
  </div>

  <label class="visually-hidden" for="envio-zona">Zona de entrega</label>
  <select id="envio-zona" data-envio-zona>
    {zonas().map((z) => (
      <option value={z.id} selected={z.id === zonaDefault()}>{z.label}</option>
    ))}
  </select>

  <p class="envio-result" data-envio-result role="status" aria-live="polite"></p>
  <p class="envio-nota">
    Gratis a {zonaGratisLabel()} llevando {envioGratisUnidades()} productos o más,
    y siempre gratis si te suscribís, aunque lleves uno solo. Al interior se
    cobra siempre.
  </p>
</div>

<style>
  .envio {
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 1.15rem 1.25rem;
  }
  .envio-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
  }
  .envio-head svg {
    width: 20px;
    height: 20px;
    color: var(--tierra);
  }
  .envio select {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text);
    background: var(--crema);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-btn);
    padding: 0.7rem 0.8rem;
    cursor: pointer;
  }
  .envio-result {
    font-size: 0.9rem;
    color: var(--text-soft);
    margin-top: 0.85rem;
  }
  .envio-result b {
    color: var(--verde);
    font-weight: 600;
  }
  .envio-nota {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }
</style>

<script>
  import { zonaPorId } from '../lib/shipping';
  import { formatPrice } from '../lib/format';

  function initEnvio() {
    document.querySelectorAll<HTMLElement>('[data-envio]').forEach((box) => {
      if (box.dataset.bound) return;
      box.dataset.bound = '1';
      const sel = box.querySelector<HTMLSelectElement>('[data-envio-zona]');
      const out = box.querySelector<HTMLElement>('[data-envio-result]');
      if (!sel || !out) return;

      const render = () => {
        const z = zonaPorId(sel.value);
        out.innerHTML =
          z.costo === 0
            ? `<b>Sin costo</b> · ${z.demora}.`
            : `<b>${formatPrice(z.costo)}</b> · llega en ${z.demora}.`;
      };

      sel.addEventListener('change', render);
      render();
    });
  }

  document.addEventListener('astro:page-load', initEnvio);
</script>
