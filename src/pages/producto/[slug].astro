<script>
  // Galería: cambiar imagen principal al tocar un thumb
  function initGallery() {
    document.querySelectorAll<HTMLElement>('[data-gallery-main]').forEach((main) => {
      if (main.dataset.bound) return;
      main.dataset.bound = '1';
      const img = main.querySelector('img');
      const thumbs = document.querySelectorAll<HTMLButtonElement>('[data-thumb]');
      thumbs.forEach((t) => {
        t.addEventListener('click', () => {
          if (img) img.src = t.dataset.thumb!;
          thumbs.forEach((x) => x.classList.remove('is-active'));
          t.classList.add('is-active');
        });
      });
    });
  }

  // "Ver las N reseñas": el resto ya está en el HTML (bueno para SEO y para
  // quien navega sin JS), sólo se despliega.
  function initResenas() {
    document.querySelectorAll<HTMLButtonElement>('[data-resenas-toggle]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      const extra = document.querySelector<HTMLElement>('[data-resenas-extra]');
      btn.addEventListener('click', () => {
        if (!extra) return;
        extra.hidden = !extra.hidden;
        btn.textContent = extra.hidden ? btn.dataset.labelMas ?? 'Ver todas las reseñas' : 'Ver menos';
      });
      btn.dataset.labelMas = btn.textContent ?? 'Ver todas las reseñas';
    });
  }

  // La barra flotante no duplica la lógica de precios: lleva a la caja de
  // compra real, que es donde está la elección hecha.
  function initStickyBuy() {
    document.querySelectorAll<HTMLButtonElement>('[data-sticky-buy]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const box = document.querySelector<HTMLElement>('[data-buybox]');
        box?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
  }

  // Con ClientRouter (View Transitions) astro:page-load también corre en la
  // carga inicial, así que NO llamamos init directo (evita doble binding).
  document.addEventListener('astro:page-load', () => {
    initGallery();
    initResenas();
    initStickyBuy();
  });
</script>
