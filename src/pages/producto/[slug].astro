---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Accordion from '../../components/Accordion.astro';
import BuyBox from '../../components/BuyBox.astro';
import CrossSellRow from '../../components/CrossSellRow.astro';
import PorQueFunciona from '../../components/PorQueFunciona.astro';
import EnvioCalculator from '../../components/EnvioCalculator.astro';
import Stars from '../../components/Stars.astro';
import Logo from '../../components/Logo.astro';
import DosageCalculator from '../../components/DosageCalculator.astro';
import { objetivoLabels, lineaLabels } from '../../lib/products';
import { getCatalogBySlug, getCatalogBySlugs } from '../../lib/catalog';
import { lineaColor } from '../../lib/types';
import { formatPrice } from '../../lib/format';
import { calcularPrecio } from '../../lib/pricing';
import { site, disclaimer } from '../../lib/site';

// SSR: la ficha lee el producto de Supabase (con fallback local). Así las
// altas/ediciones del panel se ven sin reconstruir el sitio.
export const prerender = false;

const product = await getCatalogBySlug(Astro.params.slug ?? '');
if (!product) return Astro.redirect('/tienda');

/**
 * Párrafos de la descripción larga. El texto viene del panel y se escribe en
 * un textarea, así que puede traer **negritas** al estilo markdown: se venían
 * mostrando con los asteriscos a la vista. Escapamos el HTML primero y recién
 * después convertimos las negritas, para que el contenido del panel no pueda
 * inyectar markup.
 */
function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

const descripcionParrafos = (product.descripcionLarga ?? '')
  .split(/\n\s*\n/)
  .map((s) => s.trim())
  .filter(Boolean)
  .map((p) => escapeHtml(p).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>'));

const {
  nombre,
  linea,
  tipo,
  precio,
  precioAnterior,
  volumen,
  graduacion,
  objetivos,
  beneficios = [],
  paraQueMomento,
  modoDeUso,
  ingredientes,
  nuestroProceso,
  envioYCuidado,
  advertencias,
  imagenes = [],
  stock = 0,
  combinaCon = [],
  reseñas = [],
  ingredientesDestacados = [],
  suscribible = true,
  badge,
} = product;

const cross = await getCatalogBySlugs(combinaCon);

const sinStock = stock <= 0;
const avgRating =
  reseñas.length > 0
    ? reseñas.reduce((s, r) => s + r.estrellas, 0) / reseñas.length
    : 0;

// Las primeras tres se muestran siempre; el resto se despliega. Un muro de
// reseñas no se lee, tres bien puestas sí.
const reseñasVisibles = reseñas.slice(0, 3);
const reseñasRestantes = reseñas.slice(3);

// Precio de suscripción, para el gancho de ahorro del cabezal.
const sub = calcularPrecio({ precio, modalidad: 'suscripcion', qty: 1 });

// La calculadora de dosis va en su propia sección, no en un acordeón: la
// pregunta "¿cuánto tomo?" aparece justo después de decidir la compra, y
// escondida detrás de un click no la ve nadie. Guardamos el tipo ya
// estrechado para que el componente reciba exactamente lo que acepta.
const tipoDosis = tipo === 'extracto' || tipo === 'esencia' ? tipo : null;

const acordeones = [
  { title: 'Modo de uso', body: modoDeUso },
  { title: 'Ingredientes y graduación', body: ingredientes },
  { title: 'Nuestro proceso', body: nuestroProceso },
  { title: 'Envío y cuidado', body: envioYCuidado },
  { title: 'Advertencias', body: advertencias },
].filter((a) => a.body);

const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(
  `Hola 🌿 Quería consultar por ${nombre}`
)}`;

// Datos estructurados schema.org/Product
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: nombre,
  description: paraQueMomento,
  brand: { '@type': 'Brand', name: site.name },
  category: lineaLabels[linea],
  offers: {
    '@type': 'Offer',
    priceCurrency: 'ARS',
    price: precio,
    availability: sinStock
      ? 'https://schema.org/OutOfStock'
      : 'https://schema.org/InStock',
    url: new URL(`/producto/${product.slug}`, site.url).href,
  },
  ...(reseñas.length > 0 && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: avgRating.toFixed(1),
      reviewCount: reseñas.length,
    },
  }),
};
---

<BaseLayout title={nombre} description={paraQueMomento}>
  <Fragment slot="head">
    <meta property="og:type" content="product" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <nav class="breadcrumb" aria-label="Migas de pan">
    <div class="wrap">
      <a href="/">Inicio</a><span aria-hidden="true">/</span>
      <a href="/tienda">Tienda</a><span aria-hidden="true">/</span>
      <span aria-current="page">{nombre}</span>
    </div>
  </nav>

  <!--
    El orden del DOM es el orden de mobile: cabezal, foto, beneficios, compra.
    En desktop las mismas piezas se reacomodan con grid-template-areas (galería
    sticky a la izquierda). Un solo markup, sin nada duplicado ni oculto.
  -->
  <section class="section pdp">
    <div class="wrap pdp-grid">
      <!-- Cabezal: nombre, qué es y qué opina la gente, ANTES de la foto -->
      <header class="pdp-head" data-enter style="--enter-delay:40ms">
        <span class="eyebrow" style={`color:${lineaColor[linea]}`}>{lineaLabels[linea]}</span>
        <h1>{nombre}</h1>
        {(volumen || graduacion) && (
          <p class="head-meta">{[volumen, graduacion].filter(Boolean).join(' · ')}</p>
        )}
        {paraQueMomento && <p class="head-lead">{paraQueMomento}</p>}
        <!-- El ahorro por suscripción vive dentro de la caja de compra, al
             lado del precio que lo produce. Acá arriba era una promesa suelta
             que la persona no podía verificar contra ningún número. -->
        {reseñas.length > 0 && (
          <a href="#resenas" class="rating-link">
            <Stars value={avgRating} />
            <span>
              {avgRating.toFixed(1)} · {reseñas.length}{' '}
              {reseñas.length === 1 ? 'reseña' : 'reseñas'}
            </span>
          </a>
        )}
      </header>

      <!-- Galería -->
      <div class="gallery" data-enter style="--enter-delay:100ms">
        <div class="gallery-main" data-gallery-main>
          {imagenes.length > 0 ? (
            <img src={imagenes[0]} alt={nombre} width="800" height="800" fetchpriority="high" />
          ) : (
            <span class="gallery-ph" aria-hidden="true">
              <Logo size={110} stroke="var(--salvia)" accent="var(--tierra)" />
              <em>Fotos en camino</em>
            </span>
          )}
          {badge && !sinStock && <span class="g-badge">{badge}</span>}
          {sinStock && <span class="g-badge g-badge-out">Agotado</span>}
          {precioAnterior && precioAnterior > precio && !sinStock && (
            <span class="g-badge g-badge-off">
              {Math.round((1 - precio / precioAnterior) * 100)}% off
            </span>
          )}
        </div>
        {imagenes.length > 1 && (
          <div class="gallery-thumbs" role="list">
            {imagenes.map((src, i) => (
              <button
                class:list={['thumb', { 'is-active': i === 0 }]}
                type="button"
                data-thumb={src}
                aria-label={`Ver imagen ${i + 1}`}
              >
                <img src={src} alt="" width="120" height="120" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Compra: beneficios → caja → confianza → cross-sell -->
      <div class="pdp-buy" data-enter style="--enter-delay:160ms">
        {beneficios.length > 0 && (
          <ul class="benefits" role="list">
            {beneficios.map((b) => <li>{b}</li>)}
          </ul>
        )}

        <ul class="obj-tags" role="list">
          {objetivos.map((o) => (
            <li><a href={`/tienda?objetivo=${o}`}>{objetivoLabels[o]}</a></li>
          ))}
        </ul>

        {sinStock ? (
          <div class="buy-out">
            <p>Por ahora está agotado. Escribinos y te avisamos apenas vuelva.</p>
            <a class="btn btn-ghost" href={waHref} target="_blank" rel="noopener noreferrer">
              Avisame por WhatsApp
            </a>
          </div>
        ) : (
          <BuyBox product={product} />
        )}

        {stock > 0 && stock <= 6 && (
          <p class="stock-hint">Quedan {stock} unidades de este lote</p>
        )}

        <!-- Confianza: lo que una persona que no nos conoce necesita saber
             antes de dejar la tarjeta. -->
        <ul class="trust" role="list">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 4v6c0 4-3 6.5-7 8-4-1.5-7-4-7-8V7z"></path><path d="M9 12l2 2 4-4"></path></svg>
            <span><b>Compra protegida</b> con Mercado Pago</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"></path><circle cx="7" cy="17" r="1.6"></circle><circle cx="17.5" cy="17" r="1.6"></circle></svg>
            <span><b>Envío en 24–72 h</b> a todo el país, embalaje protegido</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 1 1-3.2-6.4"></path><path d="M21 5v4h-4"></path></svg>
            <span><b>Cambios sin vueltas</b> dentro de los 10 días</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z"></path></svg>
            <span><b>Atención humana</b> por WhatsApp, te contestamos nosotros</span>
          </li>
        </ul>

        <details class="envio-toggle">
          <summary>¿Cuánto sale el envío a mi zona?</summary>
          <EnvioCalculator />
        </details>

        <CrossSellRow productos={cross} />
      </div>
    </div>
  </section>

  <!-- Dosis: sección propia y visible, no escondida en un acordeón -->
  {tipoDosis && (
    <section class="section dosis-section">
      <div class="wrap dosis-wrap">
        <div class="dosis-head" data-reveal="rise">
          <h2>¿Cuánto me corresponde?</h2>
          <p>
            No hay una dosis única: depende de tu peso y de qué estés buscando.
            Movés los controles y te decimos por dónde empezar.
          </p>
        </div>
        <DosageCalculator tipo={tipoDosis} nombre={nombre} />
      </div>
    </section>
  )}

  <!-- Educación: por qué funciona -->
  {ingredientesDestacados.length > 0 && (
    <section class="section pqf-section">
      <div class="wrap">
        <PorQueFunciona items={ingredientesDestacados} />
      </div>
    </section>
  )}

  <!-- Descripción larga -->
  {descripcionParrafos.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="descripcion" data-reveal="rise">
          <h2>Sobre este ritual</h2>
          <div class="prose-body">
            {descripcionParrafos.map((p) => <p set:html={p} />)}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Reseñas -->
  {reseñas.length > 0 && (
    <section class="section resenas" id="resenas">
      <div class="wrap">
        <div class="resenas-top" data-reveal="rise">
          <div class="resenas-avg">
            <span class="avg-num">{avgRating.toFixed(1)}</span>
            <div>
              <Stars value={avgRating} size={18} />
              <!-- No decimos "de compras verificadas" en bloque: sólo lo
                   son las reseñas marcadas una por una. -->
              <p>{reseñas.length} {reseñas.length === 1 ? 'reseña' : 'reseñas'}</p>
            </div>
          </div>
          <span class="eyebrow">Lo que dicen</span>
        </div>

        <div class="resenas-grid" data-reveal-group data-reveal-step="80">
          {reseñasVisibles.map((r) => (
            <figure class="resena">
              <div class="resena-top">
                <Stars value={r.estrellas} />
                {r.verificada && (
                  <span class="verificada">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 6"></path></svg>
                    Compra verificada
                  </span>
                )}
              </div>
              <blockquote>“{r.texto}”</blockquote>
              <figcaption>
                <b>{r.autor}</b>{r.fecha && <span> · {r.fecha}</span>}
              </figcaption>
            </figure>
          ))}
        </div>

        {reseñasRestantes.length > 0 && (
          <div class="resenas-more">
            <div class="resenas-grid" data-resenas-extra hidden>
              {reseñasRestantes.map((r) => (
                <figure class="resena">
                  <div class="resena-top">
                    <Stars value={r.estrellas} />
                    {r.verificada && (
                      <span class="verificada">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 6"></path></svg>
                        Compra verificada
                      </span>
                    )}
                  </div>
                  <blockquote>“{r.texto}”</blockquote>
                  <figcaption>
                    <b>{r.autor}</b>{r.fecha && <span> · {r.fecha}</span>}
                  </figcaption>
                </figure>
              ))}
            </div>
            <button class="btn btn-ghost" type="button" data-resenas-toggle>
              Ver las {reseñas.length} reseñas
            </button>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Detalle fino: lo que se consulta después de decidir -->
  {acordeones.length > 0 && (
    <section class="section">
      <div class="wrap acordeones">
        {acordeones.map((a, i) => (
          <Accordion title={a.title} open={i === 0}>
            <p>{a.body}</p>
          </Accordion>
        ))}
      </div>
    </section>
  )}

  <!-- Disclaimer ANMAT: al final, sin partir la página de compra -->
  <section class="wrap">
    <p class="disclaimer-box" data-reveal="fade">{disclaimer}</p>
  </section>

  <!-- CTA flotante: aparece cuando el botón real sale de pantalla -->
  {!sinStock && (
    <div class="sticky-cta" data-sticky-cta hidden={sinStock}>
      <div class="sc-info">
        <b>{nombre}</b>
        <span>
          {suscribible
            ? `desde ${formatPrice(sub.unitario)} con suscripción`
            : formatPrice(precio)}
        </span>
      </div>
      <button class="sc-btn" type="button" data-sticky-buy>Comprar</button>
    </div>
  )}
</BaseLayout>

<style>
  .breadcrumb {
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-block: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .breadcrumb .wrap {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .breadcrumb a:hover {
    color: var(--tierra);
  }
  .breadcrumb [aria-current] {
    color: var(--text);
  }

  /* Mobile: una columna en el orden del DOM (cabezal → foto → compra).
     Desktop: dos columnas, con el cabezal arriba de la columna de compra. */
  .pdp-grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.25rem);
    grid-template-areas:
      'head'
      'gallery'
      'buy';
  }
  .pdp-head {
    grid-area: head;
  }
  .gallery {
    grid-area: gallery;
  }
  .pdp-buy {
    grid-area: buy;
  }

  @media (min-width: 900px) {
    .pdp-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(2rem, 5vw, 3.5rem);
      row-gap: 1.5rem;
      align-items: start;
      grid-template-areas:
        'gallery head'
        'gallery buy';
    }
    .gallery {
      position: sticky;
      top: 96px;
    }
  }

  /* ---- Cabezal ---- */
  .pdp-head h1 {
    font-size: clamp(1.9rem, 1.2rem + 2.6vw, 2.9rem);
    line-height: var(--lh-snug);
    margin: 0.4rem 0 0.35rem;
  }
  .head-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .head-lead {
    font-size: var(--fs-lead);
    color: var(--text-soft);
    margin: 0.75rem 0 0;
    max-width: 46ch;
  }
  .rating-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .rating-link:hover {
    color: var(--tierra);
  }

  /* Sección de dosis: fuera del acordeón. "¿Cuánto tomo?" es la duda que
     aparece justo después de decidir la compra, no un detalle escondido. */
  .dosis-section {
    background: var(--bg-alt);
  }
  .dosis-wrap {
    max-width: 720px;
    margin-inline: auto;
  }
  .dosis-head {
    text-align: center;
    margin-bottom: clamp(1.25rem, 3vw, 1.75rem);
  }
  .dosis-head h2 {
    font-family: var(--font-serif);
    font-size: var(--fs-h2);
    color: var(--verde);
    margin-bottom: 0.5rem;
  }
  .dosis-head p {
    font-size: 0.92rem;
    color: var(--text-soft);
    max-width: 52ch;
    margin-inline: auto;
  }

  /* ---- Galería ---- */
  .gallery {
    display: grid;
    gap: 0.75rem;
  }
  .gallery-main {
    position: relative;
    aspect-ratio: var(--img-aspect, 1 / 1);
    border-radius: var(--r-lg);
    overflow: hidden;
    background:
      radial-gradient(80% 80% at 50% 35%, color-mix(in srgb, var(--salvia) 10%, transparent), transparent),
      var(--crema-2);
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
  }
  .gallery-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
    will-change: transform;
  }
  .gallery-main:hover img {
    transform: scale(1.08);
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-main img,
    .gallery-main:hover img {
      transition: none;
      transform: none;
    }
  }
  .gallery-ph {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    opacity: 0.6;
  }
  .gallery-ph em {
    font-style: normal;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
  .g-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--verde);
    color: var(--crema);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border-radius: var(--r-pill);
  }
  .g-badge-out {
    background: var(--carbon);
  }
  .g-badge-off {
    left: auto;
    right: 1rem;
    background: var(--tierra);
  }
  .gallery-thumbs {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .thumb {
    width: 72px;
    height: 72px;
    border-radius: var(--r-sm);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--crema-2);
    cursor: pointer;
    padding: 0;
    transition: border-color var(--dur) var(--ease-out);
  }
  .thumb.is-active {
    border-color: var(--verde);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---- Beneficios ---- */
  .benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem 1.1rem;
    margin-bottom: 1.25rem;
  }
  .benefits li {
    position: relative;
    padding-left: 1.35rem;
    font-size: 0.87rem;
    color: var(--text-soft);
    line-height: 1.45;
  }
  .benefits li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 9px;
    height: 9px;
    border-radius: var(--r-full);
    border: 1.5px solid var(--salvia);
  }
  @media (max-width: 420px) {
    .benefits {
      grid-template-columns: 1fr;
    }
  }

  .obj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.35rem;
  }
  .obj-tags a {
    display: inline-block;
    font-size: 0.76rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
    padding: 0.32rem 0.75rem;
    color: var(--text);
    transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }
  .obj-tags a:hover {
    background: var(--verde);
    color: var(--crema);
    border-color: var(--verde);
  }

  .buy-out {
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 1.25rem;
  }
  .buy-out p {
    font-size: 0.92rem;
    color: var(--text-soft);
    margin-bottom: 0.9rem;
  }
  .stock-hint {
    font-size: 0.82rem;
    color: var(--tierra);
    margin-top: 0.85rem;
    text-align: center;
  }

  /* ---- Confianza ---- */
  .trust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem 1.1rem;
    margin-top: 1.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
  }
  .trust li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.82rem;
    color: var(--text-soft);
    line-height: 1.4;
  }
  .trust svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--salvia);
    margin-top: 0.05em;
  }
  .trust b {
